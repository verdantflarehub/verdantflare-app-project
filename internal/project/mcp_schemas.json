[
  {
    "name": "project.create",
    "description": "Create a project and its first saved revision.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "ProjectCreateRequest",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit_id",
        "name",
        "category",
        "entry_path",
        "entry_text"
      ],
      "properties": {
        "commit_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "category": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "entry_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!\\.vf(?:/|$))(?!.*[. ](?:/|$))(?!.*\\/$)[^\\u0000-\\u001f\\u007f\\\\<>:\"|?*]+$"
        },
        "entry_text": {
          "type": "string",
          "maxLength": 1048576
        }
      }
    }
  },
  {
    "name": "project.list",
    "description": "List projects visible to the authenticated subject.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "ProjectListRequest",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "require_write": {
          "type": "boolean",
          "description": "Only list projects where the authenticated subject is currently an owner or editor. Defaults to false."
        },
        "category": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "cursor": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "deleted": {
          "type": "boolean",
          "description": "List deleted projects owned by the authenticated subject only. Defaults to false."
        }
      }
    }
  },
  {
    "name": "project.open",
    "description": "Open a saved project revision.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "ProjectOpenRequest",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "revision_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "require_write": {
          "type": "boolean",
          "description": "When true, opening the selected revision also requires the current project owner/editor permission; the default remains read access."
        }
      }
    }
  },
  {
    "name": "project.commit",
    "description": "Save explicit changes with a fixed commit ID and expected revision.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "ProjectCommitRequest",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "expected_revision_id",
        "commit_id"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "expected_revision_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "commit_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "changes": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "title": "ProjectChanges",
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "set_metadata": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "category": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                },
                "status": {
                  "enum": [
                    "draft",
                    "active",
                    "paused",
                    "acceptance",
                    "completed",
                    "archived"
                  ]
                },
                "entry_document_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                }
              }
            },
            "upsert_files": {
              "type": "array",
              "maxItems": 10000,
              "items": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "title": "ProjectFileUpdate",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "role"
                ],
                "properties": {
                  "file_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024,
                    "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!\\.vf(?:/|$))(?!.*[. ](?:/|$))(?!.*\\/$)[^\\u0000-\\u001f\\u007f\\\\<>:\"|?*]+$"
                  },
                  "role": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                  },
                  "content_ref": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "title": "ContentRef",
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "store_id",
                      "artifact_id",
                      "version_id"
                    ],
                    "properties": {
                      "store_id": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                      },
                      "artifact_id": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                      },
                      "version_id": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                      }
                    }
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 1048576
                  },
                  "mime": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 256,
                    "pattern": "^[^\\s;/]+/[^\\s;]+(?:;[^\\r\\n]+)?$"
                  }
                },
                "oneOf": [
                  {
                    "required": [
                      "content_ref"
                    ],
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "text"
                          ]
                        },
                        {
                          "required": [
                            "mime"
                          ]
                        }
                      ]
                    }
                  },
                  {
                    "required": [
                      "text",
                      "mime"
                    ],
                    "not": {
                      "required": [
                        "content_ref"
                      ]
                    }
                  }
                ]
              }
            },
            "remove_file_ids": {
              "type": "array",
              "maxItems": 10000,
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "uniqueItems": true
            },
            "set_selections": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "purpose",
                  "file_ids"
                ],
                "properties": {
                  "purpose": {
                    "type": "string",
                    "minLength": 1
                  },
                  "file_ids": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                    }
                  }
                }
              }
            },
            "set_asset_refs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "asset_id",
                  "asset_version_id",
                  "purpose"
                ],
                "properties": {
                  "asset_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "asset_version_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "purpose": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                }
              }
            },
            "set_run_refs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "service_id",
                  "run_id"
                ],
                "properties": {
                  "service_id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                  },
                  "run_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                }
              }
            },
            "set_domain_documents": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "document_type",
                  "file_id"
                ],
                "properties": {
                  "document_type": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                  },
                  "file_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  }
                }
              }
            }
          }
        },
        "manifest": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "title": "ProjectManifest",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "kind",
            "project_id",
            "name",
            "category",
            "status",
            "entry_document_id",
            "files",
            "selections",
            "asset_refs",
            "run_refs",
            "domain_documents"
          ],
          "properties": {
            "schema_version": {
              "const": 1
            },
            "kind": {
              "const": "project"
            },
            "project_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "category": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            },
            "status": {
              "enum": [
                "draft",
                "active",
                "paused",
                "acceptance",
                "completed",
                "archived"
              ]
            },
            "entry_document_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "files": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "file_id",
                  "path",
                  "role",
                  "content_ref"
                ],
                "properties": {
                  "file_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024,
                    "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!\\.vf(?:/|$))(?!.*[. ](?:/|$))(?!.*\\/$)[^\\u0000-\\u001f\\u007f\\\\<>:\"|?*]+$"
                  },
                  "role": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                  },
                  "content_ref": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "title": "ContentRef",
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "store_id",
                      "artifact_id",
                      "version_id"
                    ],
                    "properties": {
                      "store_id": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                      },
                      "artifact_id": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                      },
                      "version_id": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                      }
                    }
                  }
                }
              }
            },
            "selections": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "purpose",
                  "file_ids"
                ],
                "properties": {
                  "purpose": {
                    "type": "string",
                    "minLength": 1
                  },
                  "file_ids": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                    }
                  }
                }
              }
            },
            "asset_refs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "asset_id",
                  "asset_version_id",
                  "purpose"
                ],
                "properties": {
                  "asset_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "asset_version_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "purpose": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                }
              }
            },
            "run_refs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "service_id",
                  "run_id"
                ],
                "properties": {
                  "service_id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                  },
                  "run_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                }
              }
            },
            "domain_documents": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "document_type",
                  "file_id"
                ],
                "properties": {
                  "document_type": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                  },
                  "file_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  }
                }
              }
            },
            "extensions": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z][a-z0-9_-]*\\.[a-z][a-z0-9_.-]*$"
              }
            }
          }
        },
        "reselected_purposes": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "oneOf": [
        {
          "required": [
            "changes"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "manifest"
                ]
              },
              {
                "required": [
                  "reselected_purposes"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "manifest"
          ],
          "not": {
            "required": [
              "changes"
            ]
          }
        }
      ]
    }
  },
  {
    "name": "project.commit_status",
    "description": "Read the outcome of an existing project commit.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "ProjectStatusRequest",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "commit_id"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "commit_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      }
    }
  },
  {
    "name": "project.use_asset",
    "description": "Pin an explicit World asset version in a project.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "ProjectUseAssetRequest",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "expected_revision_id",
        "commit_id",
        "asset_id",
        "asset_version_id",
        "purpose"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "expected_revision_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "commit_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "asset_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "asset_version_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  },
  {
    "name": "project.delete",
    "description": "Delete a project (owner only), preserving revisions and shared content. Save change_id and recover unknown results with lifecycle_status. PROJECT_BUSY means retry after current operations finish.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "change_id",
        "expected_revision_id",
        "expected_lifecycle_version"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "change_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "expected_revision_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "expected_lifecycle_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  },
  {
    "name": "project.restore",
    "description": "Restore a deleted project with its existing ID, revisions and members (owner only).",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "change_id",
        "expected_revision_id",
        "expected_lifecycle_version"
      ],
      "properties": {
        "project_id": {
          "type": "string",
